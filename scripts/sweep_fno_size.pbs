#!/bin/bash
#PBS -P no50
#PBS -l walltime=12:00:00
#PBS -q gpuvolta
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=95GB
#PBS -l jobfs=10GB
#PBS -l wd
#PBS -l storage=scratch/yl75
#PBS -N fno_sweep_3d_henry
#PBS -o logs/fno_sweep_3d.out
#PBS -j oe

# =============================================================================
# 3-D FNO architecture sweep — grid_scenarios_random_skip2_20x40
#
# Dataset layout  : scenario_NNN/scenario.npz  (one packed file per scenario)
# Model           : 3-D FNO  n_modes=(n_modes_t, n_modes_z, n_modes_x)
# Split           : 70/30 random at run-index level, shared across all scenarios
# =============================================================================

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------

# Name of the dataset archive on scratch (without extension)
SETTING_NAME="grid_scenarios_random_skip2_20x40_new_beta"

# Source archive on RDS/scratch — adjust path as needed
DATA_ARCHIVE="/scratch/yl75/${USER}/data/simple_henry/${SETTING_NAME}.tar.gz"

if [ ! -f "${DATA_ARCHIVE}" ]; then
    echo "ERROR: Data archive not found: ${DATA_ARCHIVE}"
    exit 1
fi

# Extract to node-local fast storage (PBS_JOBFS)
tar -xf "${DATA_ARCHIVE}" -C "$PBS_JOBFS/"

# Scenarios root: the extracted folder contains scenario_NNN/ subdirs directly
SCENARIOS_ROOT="$PBS_JOBFS/${SETTING_NAME}"

# Results directory on persistent scratch
RESULTS_DIR="${RESULTS_DIR:-/scratch/yl75/${USER}/results/groundwater/fno_3d_henry_sweep/${SETTING_NAME}}"

# ---------------------------------------------------------------------------
# Python environment & Working Directory
# ---------------------------------------------------------------------------

# Prevent cluster-provided Python packages from overriding the venv packages
unset PYTHONPATH PYTHONHOME
export PYTHONNOUSERSITE=1

# cd into the project root directory
if [ -f "train_fno_sweep.py" ]; then
    :
elif [ -f "../train_fno_sweep.py" ]; then
    cd ..
elif [ -n "${PBS_O_WORKDIR:-}" ] && [ -f "${PBS_O_WORKDIR}/train_fno_sweep.py" ]; then
    cd "${PBS_O_WORKDIR}"
elif [ -n "${PBS_O_WORKDIR:-}" ] && [ -f "${PBS_O_WORKDIR}/../train_fno_sweep.py" ]; then
    cd "${PBS_O_WORKDIR}/.."
else
    cd /scratch/yl75/${USER}/src/gw_henry_fno
fi

# Activate the virtual environment
PYTHON_BIN="/scratch/yl75/${USER}/src/GW_SciML/.venv/bin/python"

# Model preset to train: default is "massive", but can be passed via qsub -v MODEL_SIZE_PRESETS=...
MODEL_SIZE_PRESETS="${MODEL_SIZE_PRESETS:-massive}"

# Number of training epochs (default: 500, can be overridden via qsub -v EPOCHS=...)
EPOCHS="${EPOCHS:-500}"

if [ ! -x "${PYTHON_BIN}" ]; then
    echo "ERROR: Python executable not found or not executable: ${PYTHON_BIN}"
    exit 1
fi

if [ ! -d "${SCENARIOS_ROOT}" ]; then
    echo "ERROR: Scenarios root directory not found: ${SCENARIOS_ROOT}"
    exit 1
fi

# Spatial and temporal grid spacing for the TotalNormLoss metric
# Can be overridden via qsub -v DT=..., DZ=..., DX=...
DT="${DT:-0.04}"
DZ="${DZ:-0.05}"
DX="${DX:-0.05}"

echo "============================================================"
echo "3-D FNO sweep — ${SETTING_NAME}"
echo "scenarios root : ${SCENARIOS_ROOT}"
echo "results dir    : ${RESULTS_DIR}"
echo "model presets  : ${MODEL_SIZE_PRESETS}"
echo "epochs         : ${EPOCHS}"
echo "grid spacing   : dt=${DT}, dz=${DZ}, dx=${DX}"
echo "device         : GPU (gpuvolta)"
echo "============================================================"

# ---------------------------------------------------------------------------
# Run the sweep
# ---------------------------------------------------------------------------

"${PYTHON_BIN}" train_fno_sweep.py \
    --scenario-dir        "${SCENARIOS_ROOT}"        \
    --sweep-mode          preset                     \
    --model-size-presets  "${MODEL_SIZE_PRESETS}"    \
    --epochs              "${EPOCHS}"                \
    --batch-size          152                        \
    --learning-rate       1e-4                       \
    --weight-decay        1e-5                       \
    --train-ratio         0.7                        \
    --seed                31                        \
    --num-workers         4                          \
    --pin-memory                                     \
    --normalize                                      \
    --scheduler-step-size 50                         \
    --scheduler-decay     0.75                       \
    --results-dir         "${RESULTS_DIR}"           \
    --device              "${DEVICE:-cuda}"          \
    --dt                  "${DT}"                    \
    --dz                  "${DZ}"                    \
    --dx                  "${DX}"

# ---------------------------------------------------------------------------
# Exit handling
# ---------------------------------------------------------------------------

status=$?
if [ "${status}" -ne 0 ]; then
    echo "Sweep failed with exit code ${status}"
    exit "${status}"
fi

echo "============================================================"
echo "Sweep completed successfully for preset(s): ${MODEL_SIZE_PRESETS}"
echo "Results written to: ${RESULTS_DIR}"
echo "============================================================"